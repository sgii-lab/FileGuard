<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileGuard</RootNamespace>
    <AssemblyName>fileguard</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lets people install it as a global dotnet tool (see README) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fileguard</ToolCommandName>
    <PackageId>FileGuard</PackageId>
    <Version>1.0.0</Version>
    <Description>A fast file integrity monitor: baseline a directory, then detect added, modified and deleted files.</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
